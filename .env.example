# =============================================================================
# Fragfun environment configuration
# Copy to .env.local for development. Set the same keys in Vercel for production.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# REQUIRED in production = (P). Optional = (O). Dev defaults shown where safe.
# =============================================================================

# --- App ---------------------------------------------------------------------
# (P) Public origin of the site, used for sign-in domain checks, CORS and metadata links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) -------------------------------------------
# (P) Supabase → Project Settings → Database → Connection string (Session pooler, port 5432).
# Leave empty in development to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=5
PGLITE_DIR=.data/pglite

# --- Supabase (public image storage) ----------------------------------------
# (P) Supabase → Project Settings → API. Create a PUBLIC storage bucket named below.
SUPABASE_URL=
# (P) Server-only. Never expose. Used to upload images to Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fragfun-public
# (O) Publishable/anon key. The app does not query Supabase from the browser; RLS only allows
# reading published content with it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sessions ----------------------------------------------------------------
# (P) 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=
SESSION_TTL_HOURS=72

# --- Solana ------------------------------------------------------------------
# (P) mainnet-beta or devnet. Server and browser values must match.
SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# (P) Dedicated RPC (Helius, Triton, QuickNode…). Public endpoints are rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# (O) Comma-separated failover RPC URLs (server-side reads/broadcasts).
SOLANA_RPC_FALLBACK_URLS=
# (P) Browser RPC for the wallet adapter. Use a domain-restricted key, never your server key.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# (O) Priority fee added to prepared transactions (micro-lamports per compute unit).
PRIORITY_FEE_MICROLAMPORTS=50000
# (O) Cap on the optional initial buy in a launch transaction.
LAUNCH_MAX_DEV_BUY_SOL=5

# --- Company wallet (treasury / operations) ---------------------------------
# (P) Official Fragfun company wallet. Public address: receives authorized platform revenue,
# balance shown in /admin, optional network-fee payer. Never put its private key here.
COMPANY_WALLET_ADDRESS=HLdg6LmRZi6Xfe5WgGLRPCXpr6auR1uodt4D3GotkhF8
# (O) ONLY if FEATURE_FEE_SPONSORSHIP=true. Server-only secret (base58 64-byte key or JSON array)
# for a DEDICATED fee-payer wallet holding a small balance. Store in Vercel encrypted env vars /
# a secrets manager. Never commit, never prefix with NEXT_PUBLIC_.
COMPANY_SIGNER_SECRET_KEY=
# (O) Company pays users' network fees. Off by default; must be switched on deliberately.
FEATURE_FEE_SPONSORSHIP=false
SPONSOR_MAX_FEE_LAMPORTS_PER_TX=100000
SPONSOR_MAX_TX_PER_DAY=200
SPONSOR_MAX_TX_PER_USER_PER_DAY=5

# --- Video -------------------------------------------------------------------
# (P) mux in production. `local` stores files on disk and is development-only.
VIDEO_PROVIDER=local
# (P) Mux → Settings → Access Tokens (Mux Video: read + write).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# (P) Mux → Settings → Webhooks → endpoint https://YOUR_DOMAIN/api/webhooks/mux → signing secret.
MUX_WEBHOOK_SECRET=
VIDEO_MAX_BYTES=209715200
VIDEO_MAX_DURATION_SECONDS=90
LOCAL_DATA_DIR=.data

# --- Token metadata (IPFS) ---------------------------------------------------
# (P on mainnet) pinata. `self` serves metadata from Fragfun storage (devnet/dev only).
METADATA_PROVIDER=self
# (P on mainnet) Pinata → API Keys → JWT with files:write.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# --- Market data -------------------------------------------------------------
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
SOL_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd
MARKET_CACHE_SECONDS=20

# --- AI assistant (optional) -------------------------------------------------
# (O) console.anthropic.com → API Keys. Without it the assistant is hidden/disabled.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Admin -------------------------------------------------------------------
# (P) Comma-separated wallet addresses granted admin after signing in with that wallet.
ADMIN_WALLETS=HLdg6LmRZi6Xfe5WgGLRPCXpr6auR1uodt4D3GotkhF8
# (P) Bearer secret Vercel Cron sends to /api/cron/reconcile.
CRON_SECRET=

# --- Feature flags -----------------------------------------------------------
FEATURE_LAUNCHES=true
FEATURE_TRADING=true
FEATURE_CLIP_WARS=true
FEATURE_AI_ASSISTANT=true
# false = new clips wait in the admin moderation queue before appearing publicly.
AUTO_APPROVE_CLIPS=true
